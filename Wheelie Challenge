<!DOCTYPE html>

<html lang="no">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Wheelie Challenge</title>

<style>

body{

margin:0;

overflow:hidden;

background:linear-gradient(#7dd3fc,#4ade80);

font-family:Arial,sans-serif;

}

#score{

position:absolute;

top:15px;

left:15px;

font-size:28px;

font-weight:bold;

color:white;

}

#bike{

position:absolute;

left:60px;

bottom:90px;

font-size:90px;

transition:0.08s;

}

#ground{

position:absolute;

bottom:0;

width:100%;

height:90px;

background:#444;

}

#button{

position:absolute;

bottom:15px;

right:15px;

width:120px;

height:120px;

background:#e53935;

color:white;

border-radius:60px;

display:flex;

justify-content:center;

align-items:center;

font-size:28px;

user-select:none;

}

.obstacle{

position:absolute;

bottom:90px;

font-size:55px;

}

</style>

</head>

<body>

<div id="score">Poeng: 0</div>

<div id="bike">🏍️</div>

<div id="ground"></div>

<div id="button">GASS</div>

<script>

let bike=document.getElementById("bike");

let score=document.getElementById("score");

let gas=document.getElementById("button");

let points=0;

let jump=0;

let up=false;

gas.ontouchstart=()=>up=true;

gas.ontouchend=()=>up=false;

function game(){

if(up){

jump+=3;

}else{

jump-=2;

}

if(jump<0)jump=0;

if(jump>140)jump=140;

bike.style.bottom=(90+jump)+"px";

bike.style.transform="rotate("+(-jump/5)+"deg)";

points++;

score.innerHTML="Poeng: "+points;

requestAnimationFrame(game);

}

game()function obstacle(){

let rock=document.createElement("div");

rock.className="obstacle";

rock.innerHTML="🪨";

rock.style.left=window.innerWidth+"px";

document.body.appendChild(rock);

let x=window.innerWidth;

let move=setInterval(function(){

x-=8;

rock.style.left=x+"px";

if(x<120 && x>40 && jump<40){

clearInterval(move);

alert("💥 Game Over!\nPoeng: "+points);

location.reload();

}

if(x<-60){

clearInterval(move);

rock.remove();

}

},20);

}

setInterval(obstacle,2000);

</script>

</body
